# Salin file ini menjadi .env di SERVER, lalu isi nilainya:
#   cp .env.cloud.example .env
#
# Tips: pakai huruf dan angka saja untuk kata sandi (karakter seperti $ # " bisa bermasalah).

# Alamat aplikasi tanpa https://  (contoh: monitoringta-kamu.southeastasia.cloudapp.azure.com)
# Untuk uji di laptop sendiri: localhost
DOMAIN=localhost

# Kata sandi database (karang sendiri, jangan sama dengan kata sandi admin)
DB_PASSWORD=ganti-dengan-sandi-db
DB_ROOT_PASSWORD=ganti-dengan-sandi-root

# Admin pertama, dibuat otomatis saat aplikasi pertama kali menyala
ADMIN_EMAIL=admin@contoh.com
ADMIN_PASSWORD=ganti-minimal-8-karakter
ADMIN_NAME=Koordinator Prodi

# Kode rahasia agar dosen bisa mendaftar sendiri. Kosongkan jika dosen hanya ditambah admin.
KODE_DAFTAR_DOSEN=

APP_NAME="Monitoring TA"
LOG_CHANNEL=stderr

# Diisi nanti, setelah membuat APK lewat PWABuilder (lihat PANDUAN.md Langkah 11)
# ANDROID_SHA256=
# ANDROID_PACKAGE=com.monitoringta.app
